{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuhang-work-report",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
